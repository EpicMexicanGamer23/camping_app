# =============================================================================
# Template for the Kubernetes postgres-secret
# =============================================================================
# Copy this file to storage.env at the project root and fill in real values,
# then create the secret with:
#
#   kubectl create secret generic postgres-secret \
#     --from-env-file=storage.env \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# NEVER commit storage.env to git.
# =============================================================================

# PostgreSQL credentials (used by the database pod, trips, and gear services)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=microservices
